{
  "$id": "data://.../code-repo",
  "title": "CodeRepo",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A code repository",
  "type": "object",
  "properties": {
    "csiId": {
      "type": "string",
      "description": "The CSI this repo belongs to"
    },
    "repoName": {
      "type": "string",
      "description": "The name of the repository"
    },
    "repoUrl": {
      "type": "string",
      "description": "The URL to the repository"
    },
    "defaultBranch": {
      "type": "string",
      "description": "The URL to the repository"
    },
    "repoType": {
      "type": "string",
      "description": "The type of repo, e.g. library, service, documentation, configuration"
    },
    "techStack": {
      "type": "object",
      "properties": {
        "primaryLanguage": {
          "type": "string",
          "description": "The repos primary lanugage, e.g. Java, Python, Markdown"
        },
        "primaryFramework": {
          "type": "string",
          "description": "The repos primary framework, e.g. Spring"
        },
        "primaryFrameworkVersion": {
          "type": "string",
          "description": "The repos primary framework, e.g. Spring"
        },
        "stack": {
          "description": "A list of the technologies found, e.e. Java, Maven, SQL, Kafka etc.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "technologyName": {
                "type": "string"
              }
            }
          }
        },
        "buildTool": {
          "type": "string",
          "description": "The build tool used for this repo, e.g. Maven, Gradle, etc."
        }
      },
      "scanData": {
        "type": "object",
        "properties": {
          "lastScanDateTime": {
            "type": "string"
          },
          "scannedCommit": {
            "type": "string"
          },
          "lastJobStatus": {
            "type": "string",
            "enum": [
              "COMPLETED",
              "FAILED"
            ]            
          }
        }
      },
      "capabilities": {
        "type": "object",
        "properties": {
          "tests": {
            "type": "bool"
          },
          "dockerfile": {
            "type": "bool"
          },
          "cicd": {
            "type": "bool"
          },
          "k8rs": {
            "type": "bool"
          }                    
        }
      }
    }
  }
}