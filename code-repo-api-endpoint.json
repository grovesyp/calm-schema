{
  "$id": "data://.../code-repo-api-endpoints",
  "title": "CodeRepoApiEndpoints",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "From a code scan, lists the API endpoints discovered",
  "type": "object",
  "properties": {
    "csiId": {
      "type": "string",
      "description": "The CSI this repo belongs to"
    },
    "repoName": {
      "type": "string",
      "description": "The name of the repository"
    },
    "endpointURI": {
      "type": "string",
      "description": "The URI of the endpoint, e.g.  api/v1/customer"
    },
    "endpointType": {
      "type": "string",
      "enum": [
        "REST",
        "GraphQL",
        "Uknown"
      ]
      
    },    
    "endpointVerb": {
      "type": "string",
      "description": "GET, DELETE, POST etc."
    },
    "codeUrlDeepLink": {
      "type": "string",
      "description": "Deeplink to the code"
    },
    "handlerName": {
      "type": "string",
      "description": "The name of the handler in code"
    }
  }
}

