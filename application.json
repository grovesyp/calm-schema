{
  "$id": "data://.../application",
  "title": "application",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "An application, made up of one more more repositories",
  "type": "object",
  "properties": {
    "applicationId": {
      "type": "string",
      "description": "The CSI this repo belongs to"
    },
    "applicationName": {
      "type": "string",
      "description": "The name of the CSI"
    },
    "languages": {
      "type": "array",
      "description": "The list of languages found in repositories for this CSI",
      "items": {
        "type": "object",
        "properties": {
            "lanugageName": {
                "type": "string",
                "description": "The name of the language"
            }
        }
      }
    }
  }
}